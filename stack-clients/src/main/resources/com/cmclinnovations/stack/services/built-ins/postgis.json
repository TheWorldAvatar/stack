{
    "type": "postgres",
    "ServiceSpec": {
        "Name": "postgis",
        "TaskTemplate": {
            "ContainerSpec": {
                "Image": "ghcr.io/theworldavatar/postgis:pgrouting-extra-18-3.6-4.0.1-3dcitydb",
                "Env": [
                    "POSTGRES_HOST_AUTH_METHOD=scram-sha-256",
                    "POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256",
                    "POSTGIS_SFCGAL=true"
                ],
                "Command": [
                    "sh",
                    "-c",
                    "sed -i 's/postgis-3,timescaledb/postgis-3/' /var/lib/postgresql/data/postgresql.conf; docker-entrypoint.sh postgres -c shared_buffers=1GB -c max_connections=200"
                ],
                "Mounts": [
                    {
                        "Type": "volume",
                        "Source": "postgis_data",
                        "Target": "/var/lib/postgresql/data"
                    },
                    {
                        "Type": "volume",
                        "Source": "geotiffs",
                        "Target": "/geotiffs"
                    },
                    {
                        "Type": "volume",
                        "Source": "multidim_geospatial",
                        "Target": "/multidim_geospatial"
                    },
                    {
                        "Type": "tmpfs",
                        "Target": "/dev/shm",
                        "TmpfsOptions": {
                            "SizeBytes": 1073741824
                        }
                    }
                ],
                "Secrets": [
                    {
                        "SecretName": "postgis_password"
                    }
                ]
            }
        }
    }
}