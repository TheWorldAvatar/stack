{
    "type": "rdf4j",
    "ServiceSpec": {
        "Name": "rdf4j",
        "TaskTemplate": {
            "ContainerSpec": {
                "Image": "docker.io/eclipse/rdf4j-workbench:6.1.0-tomcat",
                "Env": [
                    "JAVA_OPTS=-Xmx4g -XX:+HeapDumpOnOutOfMemoryError -XX:-UseBASE64Intrinsics"
                ],
                "Mounts": [
                    {
                        "Type": "volume",
                        "Source": "rdf4j-data",
                        "Target": "/var/rdf4j"
                    },
                    {
                        "Type": "volume",
                        "Source": "rdf4j-logs",
                        "Target": "/usr/local/tomcat/logs"
                    }
                ],
                "Healthcheck": {
                    "Test": [
                        "CMD",
                        "bash",
                        "-c",
                        "exec 3<>/dev/tcp/127.0.0.1/8080;echo -e 'GET /rdf4j-server/home/overview.view HTTP/1.1\nHost: 127.0.0.1\nConnection: close\n\n' >&3;grep '200 OK' <&3"
                    ],
                    "Interval": 1000000000,
                    "Timeout": 1000000000,
                    "Retries": 50,
                    "StartPeriod": 3000000000
                }
            }
        }
    },
    "endpoints": {
        "workbench": {
            "url": "http://localhost:8080/rdf4j-workbench/",
            "externalPath": "/rdf4j-workbench/"
        },
        "server": {
            "url": "http://localhost:8080/rdf4j-server/",
            "externalPath": "/rdf4j-server/"
        },
        "query": {
            "url": "http://localhost:8080/rdf4j-server/repositories/stack-incoming",
            "externalPath": "/sparql/query"
        }
    }
}