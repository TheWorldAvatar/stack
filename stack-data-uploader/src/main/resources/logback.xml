<?xml version="1.0" encoding="UTF-8"?>
<!--
    Without this file Logback falls back to BasicConfigurator, which pins the root
    logger to DEBUG and floods stdout with Apache HttpClient connection/wire noise
    (commons-logging is bridged in via jcl-over-slf4j).
-->
<configuration>
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Verbose even at DEBUG: dumps full request/response bodies. -->
    <logger name="org.apache.http.wire" level="WARN"/>
    <logger name="httpclient.wire" level="WARN"/>
    <logger name="org.apache.http.impl.conn" level="WARN"/>
    <logger name="org.apache.commons.httpclient" level="WARN"/>
    <logger name="org.eclipse.rdf4j.http.client" level="INFO"/>

    <root level="${STACK_LOG_LEVEL:-INFO}">
        <appender-ref ref="Console"/>
    </root>
</configuration>
